<UserControl x:Class="RyotaQC.App.Controls.SidebarIconButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Button x:Name="ButtonHost"
            Margin="0,5"
            Padding="0"
            Width="52"
            Height="52"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand"
            Command="{Binding Command, ElementName=Root}"
            ToolTip="{Binding ToolTipText, ElementName=Root}">
        <Border CornerRadius="14" BorderThickness="1" Padding="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#00000000" />
                    <Setter Property="BorderBrush" Value="#00000000" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ButtonHost}" Value="True">
                            <Setter Property="Background" Value="#263588BB" />
                            <Setter Property="BorderBrush" Value="#805AC9FF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsActive, ElementName=Root}" Value="True">
                            <Setter Property="Background" Value="#3A2E7CFF" />
                            <Setter Property="BorderBrush" Value="{DynamicResource NeonBlueBrush}" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="9" ShadowDepth="0" Opacity="0.38" Color="#FF2E7CFF" />
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Glyph, ElementName=Root}"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>
    </Button>
</UserControl>
