<UserControl x:Class="RyotaQC.App.Controls.HomeTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="132"
             Height="132"
             Background="Transparent"
             Cursor="Hand"
             IsTabStop="False">
    <Grid>
        <Border x:Name="TileBorder"
                CornerRadius="22"
                Background="#121625"
                Width="96"
                Height="96"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Grid ClipToBounds="True">
                <Image x:Name="TileImage"
                       Source="{Binding ImageSource, ElementName=Root}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="5" />
                <Border Background="#33101525" />
                <Border x:Name="GlowBorder"
                        CornerRadius="22"
                        BorderBrush="White"
                        BorderThickness="1.6"
                        Opacity="0" />

                <!-- Danger zone overlay (blocked menu) -->
                <Grid x:Name="DangerOverlay" Visibility="Collapsed">
                    <Border CornerRadius="22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" SpreadMethod="Repeat">
                                <GradientStop Color="#FFF2C200" Offset="0" />
                                <GradientStop Color="#FFF2C200" Offset="0.1" />
                                <GradientStop Color="#FF151515" Offset="0.1" />
                                <GradientStop Color="#FF151515" Offset="0.2" />
                                <GradientStop Color="#FFF2C200" Offset="0.2" />
                                <GradientStop Color="#FFF2C200" Offset="0.3" />
                                <GradientStop Color="#FF151515" Offset="0.3" />
                                <GradientStop Color="#FF151515" Offset="0.4" />
                                <GradientStop Color="#FFF2C200" Offset="0.4" />
                                <GradientStop Color="#FFF2C200" Offset="0.5" />
                                <GradientStop Color="#FF151515" Offset="0.5" />
                                <GradientStop Color="#FF151515" Offset="0.6" />
                                <GradientStop Color="#FFF2C200" Offset="0.6" />
                                <GradientStop Color="#FFF2C200" Offset="0.7" />
                                <GradientStop Color="#FF151515" Offset="0.7" />
                                <GradientStop Color="#FF151515" Offset="0.8" />
                                <GradientStop Color="#FFF2C200" Offset="0.8" />
                                <GradientStop Color="#FFF2C200" Offset="0.9" />
                                <GradientStop Color="#FF151515" Offset="0.9" />
                                <GradientStop Color="#FF151515" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border CornerRadius="22" Background="#9C0B0B0B" />

                    <Border Height="24" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" SpreadMethod="Repeat">
                                <GradientStop Color="#FFF2C200" Offset="0" />
                                <GradientStop Color="#FFF2C200" Offset="0.1" />
                                <GradientStop Color="#FF151515" Offset="0.1" />
                                <GradientStop Color="#FF151515" Offset="0.2" />
                                <GradientStop Color="#FFF2C200" Offset="0.2" />
                                <GradientStop Color="#FFF2C200" Offset="0.3" />
                                <GradientStop Color="#FF151515" Offset="0.3" />
                                <GradientStop Color="#FF151515" Offset="0.4" />
                                <GradientStop Color="#FFF2C200" Offset="0.4" />
                                <GradientStop Color="#FFF2C200" Offset="0.5" />
                                <GradientStop Color="#FF151515" Offset="0.5" />
                                <GradientStop Color="#FF151515" Offset="0.6" />
                                <GradientStop Color="#FFF2C200" Offset="0.6" />
                                <GradientStop Color="#FFF2C200" Offset="0.7" />
                                <GradientStop Color="#FF151515" Offset="0.7" />
                                <GradientStop Color="#FF151515" Offset="0.8" />
                                <GradientStop Color="#FFF2C200" Offset="0.8" />
                                <GradientStop Color="#FFF2C200" Offset="0.9" />
                                <GradientStop Color="#FF151515" Offset="0.9" />
                                <GradientStop Color="#FF151515" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#E6F2C200" Padding="8,2" CornerRadius="3">
                            <TextBlock Text="BLOCKED"
                                       FontFamily="Segoe UI"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#FF141414" />
                        </Border>
                    </Border>

                    <Border Width="44"
                            Height="44"
                            CornerRadius="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#CC0E1420"
                            BorderBrush="#FFF2C200"
                            BorderThickness="2">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="20"
                                   Foreground="#FFF2C200"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Border Background="#66F2C200" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="2" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.12" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="GlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
