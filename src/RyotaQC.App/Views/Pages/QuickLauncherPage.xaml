<Page x:Class="RyotaQC.App.Views.Pages.QuickLauncherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:conv="clr-namespace:RyotaQC.App.Converters"
      mc:Ignorable="d"
      Background="Transparent"
      PreviewKeyDown="Page_OnPreviewKeyDown">
    <Page.Resources>
        <conv:ImagePathConverter x:Key="ImagePathConverter" />

        <!-- Option row status text color -->
        <Style x:Key="StepStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="#7E879A" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="#FBBF24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter Property="Foreground" Value="#34D399" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="#F87171" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter Property="Foreground" Value="#4CA7FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Foreground" Value="#94A3B8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OptionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Host"
                                Background="#2A121625"
                                BorderBrush="#335A87E6"
                                BorderThickness="1.2"
                                CornerRadius="12"
                                Padding="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#3A1B2B4A" />
                                <Setter TargetName="Host" Property="BorderBrush" Value="#6A4CA7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Host" Property="Background" Value="#4A2E5A8C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#AEB7CA" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter Property="Foreground" Value="#F87171" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="WARN">
                    <Setter Property="Foreground" Value="#FBBF24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="SUCCESS">
                    <Setter Property="Foreground" Value="#34D399" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="48,0,48,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{Binding BackToHomeCommand}"
                    Style="{StaticResource BackIconButtonStyle}"
                    ToolTip="Kembali ke Main Menu" />
            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Quick"
                           Foreground="#FFFFFF"
                           FontFamily="Segoe UI"
                           FontSize="34"
                           FontWeight="Bold" />
                <TextBlock Text="Tekan angka 1-9 atau klik opsi untuk menjalankan"
                           Foreground="#7E879A"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: numbered options -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,14,0">
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource OptionButtonStyle}" Click="Option_Click" Tag="{Binding Number}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#33263A5E" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Number}"
                                                   Foreground="#4CA7FF"
                                                   FontFamily="Segoe UI"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#FFFFFF"
                                                   FontFamily="Segoe UI"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StepStatusTextStyle}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding IconGlyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="18"
                                               Foreground="#4CA7FF"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- RIGHT: context panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="230" />
                </Grid.RowDefinitions>

                <!-- Identity + wallpaper grid (swap) -->
                <Grid Grid.Row="0">
                    <ScrollViewer x:Name="IdentityPanel" VerticalScrollBarVisibility="Auto">
                        <!-- Identity panel -->
                        <Border Style="{StaticResource QuickCardStyle}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="IDENTITAS UNIT"
                                           Foreground="#4CA7FF"
                                           FontFamily="Segoe UI"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Margin="0,0,0,12" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,16,10">
                                        <TextBlock Text="OS Name" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding OsName}" Style="{StaticResource QuickValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="OS Version" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding OsVersion}" Style="{StaticResource QuickValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,10">
                                        <TextBlock Text="System Model" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding SystemModel}" Style="{StaticResource QuickValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="BIOS Serial Number" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding SerialNumber}" Style="{StaticResource QuickValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,10">
                                        <TextBlock Text="CPU / Processor" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding CpuName}" Style="{StaticResource QuickValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="LCD" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding LcdInfo}" Style="{StaticResource QuickValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,10">
                                        <TextBlock Text="VGA" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding VgaInfo}" Style="{StaticResource QuickValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="Nama Unit (Rename)" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding UnitName}" Style="{StaticResource QuickValueStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="UPGRADE — RAM"
                                           Foreground="#4CA7FF"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="0,8,0,8" />
                                <UniformGrid Columns="4">
                                    <StackPanel Margin="0,0,10,6">
                                        <TextBlock Text="Terinstall" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding RamInstalled}" Style="{StaticResource QuickSubValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,6">
                                        <TextBlock Text="Slot Terpasang" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding RamSlotsUsed}" Style="{StaticResource QuickSubValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,6">
                                        <TextBlock Text="Slot Tersedia" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding RamSlotsFree}" Style="{StaticResource QuickSubValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Speed" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding RamSpeed}" Style="{StaticResource QuickSubValueStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="UPGRADE — SSD / HDD"
                                           Foreground="#4CA7FF"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="0,8,0,8" />
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,10,6">
                                        <TextBlock Text="Jenis Disk" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding DiskType}" Style="{StaticResource QuickSubValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,10,6">
                                        <TextBlock Text="Interface" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding DiskInterface}" Style="{StaticResource QuickSubValueStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Total Disk" Style="{StaticResource QuickLabelStyle}" />
                                        <TextBlock Text="{Binding DiskTotal}" Style="{StaticResource QuickSubValueStyle}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="DRIVER PLAN" Style="{StaticResource QuickLabelStyle}" Margin="0,10,0,4" />
                                <TextBlock Text="{Binding DriverPlanText}" Style="{StaticResource QuickSubValueStyle}" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- Wallpaper grid -->
                    <Border x:Name="WallpaperPanel"
                            Style="{StaticResource QuickCardStyle}"
                            Padding="20,16"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="PILIH WALLPAPER — klik untuk set as desktop"
                                       Foreground="#4CA7FF"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Margin="0,0,0,12" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Wallpapers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.WallpaperCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,10,10"
                                                    Cursor="Hand"
                                                    Focusable="False">
                                                <Border Width="170" Height="100" CornerRadius="10" BorderBrush="#555A87E6" BorderThickness="1.2" ClipToBounds="True">
                                                    <Image Source="{Binding FilePath, Converter={StaticResource ImagePathConverter}}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="LowQuality" />
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Log panel -->
                <Border Grid.Row="1" Style="{StaticResource QuickCardStyle}" Padding="14,10" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="LIVE LOG"
                                   Foreground="#4CA7FF"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6" />
                        <ListBox Grid.Row="1"
                                 x:Name="LogList"
                                 ItemsSource="{Binding LogLines}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11" Foreground="#5A6478" Margin="0,0,8,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource LogTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer: progress -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Height="6" Maximum="100" Value="{Binding ProgressPercent}" Background="#22121625" Foreground="#4CA7FF" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#AEB7CA" FontFamily="Segoe UI" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- ================= POPUP OVERLAY ================= -->
        <Grid x:Name="PopupOverlay"
              Grid.RowSpan="3"
              Background="#A0050812"
              Visibility="Collapsed"
              Panel.ZIndex="500">
            <!-- Confirm dialog -->
            <Border x:Name="ConfirmPopup"
                    Width="460"
                    Padding="24"
                    CornerRadius="18"
                    Background="#EE121625"
                    BorderBrush="#554CA7FF"
                    BorderThickness="1.4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="KONFIRMASI" Foreground="#4CA7FF" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" />
                    <TextBlock x:Name="ConfirmMessage"
                               TextWrapping="Wrap"
                               Foreground="#F6F8FF"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               Margin="0,10,0,4" />
                    <TextBlock x:Name="ConfirmCountdown"
                               Foreground="#FBBF24"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Margin="0,4,0,16" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Tidak" Click="ConfirmNo_Click" Style="{StaticResource HomeDotsButtonStyle}" MinWidth="110" Height="44" FontSize="14" />
                        <Button Content="Ya, Lanjutkan" Click="ConfirmYes_Click" Style="{StaticResource HomePrimaryButtonStyle}" MinWidth="150" Height="44" Margin="10,0,0,0" FontSize="14" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- App method dialog -->
            <Border x:Name="AppMethodPopup"
                    Width="460"
                    Padding="24"
                    CornerRadius="18"
                    Background="#EE121625"
                    BorderBrush="#554CA7FF"
                    BorderThickness="1.4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="PILIH METODE INSTALL APLIKASI" Foreground="#4CA7FF" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" />
                    <TextBlock x:Name="AppMethodCountdown"
                               Foreground="#FBBF24"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Margin="0,8,0,16" />
                    <Button Content="[1] Offline — install semua dari folder offline"
                            Click="AppOffline_Click"
                            Style="{StaticResource HomePrimaryButtonStyle}"
                            Height="52" HorizontalAlignment="Stretch" FontSize="14" />
                    <Button Content="[2] Online — AppPack (butuh internet)"
                            Click="AppOnline_Click"
                            Style="{StaticResource HomeDotsButtonStyle}"
                            Height="52" HorizontalAlignment="Stretch" Margin="0,10,0,0" FontSize="14" />
                    <Button Content="Batal"
                            Click="AppCancel_Click"
                            Style="{StaticResource HomeDotsButtonStyle}"
                            Height="40" MinWidth="100" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="13" />
                </StackPanel>
            </Border>

            <!-- Results dialog -->
            <Border x:Name="ResultsPopup"
                    Width="640"
                    MaxHeight="560"
                    Padding="24"
                    CornerRadius="18"
                    Background="#EE121625"
                    BorderBrush="#554CA7FF"
                    BorderThickness="1.4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="HASIL AKHIR — RUN ALL" Foreground="#4CA7FF" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ResultsList" />
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Tutup" Click="ResultsClose_Click" Style="{StaticResource HomePrimaryButtonStyle}" Height="44" MinWidth="140" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
