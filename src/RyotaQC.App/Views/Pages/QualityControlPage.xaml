<Page x:Class="RyotaQC.App.Views.Pages.QualityControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="QcChecklistRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="#330F2238" />
            <Setter Property="BorderBrush" Value="#55477CFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="QcCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource SelectedFocusVisualStyle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiBold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="QcStatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#332E7CFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#556F9BFF" />
        </Style>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="QcLeftPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.30">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="QcLeftPanel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="18" To="0"
                                     Duration="0:0:0.34">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="QcRightPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.30"
                                     BeginTime="0:0:0.06">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="QcRightPanel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="18" To="0"
                                     Duration="0:0:0.34"
                                     BeginTime="0:0:0.06">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid Margin="20,0,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="QcLeftPanel"
                Grid.Column="0"
                Style="{StaticResource Ps5GlassCardStyle}"
                Margin="0,0,10,0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Command="{Binding BackToHomeCommand}"
                            Style="{StaticResource BackIconButtonStyle}"
                            ToolTip="Kembali ke Main Menu"
                            HorizontalAlignment="Left" />

                    <TextBlock Text="Quality Control"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               FontSize="28"
                               Margin="0,8,0,0" />

                    <TextBlock Text="Catatan Otomatis"
                               Margin="0,14,0,4"
                               FontFamily="Bahnschrift SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBox Text="{Binding ChecklistSummary}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Height="160"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontSize="13"
                             Margin="0" />

                    <TextBlock Text="Catatan Tambahan"
                               Margin="0,10,0,4"
                               FontFamily="Bahnschrift SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Height="140"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontSize="13"
                             Margin="0" />

                    <Button Content="Hasil QC"
                            Command="{Binding ShowOverallQcResultsCommand}"
                            Style="{StaticResource BigPrimaryButtonStyle}"
                            Width="160"
                            Height="40"
                            Margin="0,10,0,6"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="QcRightPanel"
                Grid.Column="1"
                Style="{StaticResource QcPanelCardStyle}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Quality Control"
                           Style="{StaticResource CardTitleTextStyle}"
                           FontSize="40"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="Bahnschrift SemiBold"
                           Margin="0,0,0,10" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Refresh List"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource RoundedActionButtonStyle}"
                                    Width="120"
                                    Height="34" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DisplayChecklistItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource QcChecklistRowStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Style="{StaticResource QcCheckBoxStyle}" />
                                                <Image Source="{Binding IconPath}"
                                                       Width="24"
                                                       Height="24"
                                                       Margin="0,0,10,0"
                                                       Stretch="Uniform" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="Bahnschrift SemiBold"
                                                           FontSize="17"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Run"
                                                    Command="{Binding RunCommand}"
                                                    Style="{StaticResource RoundedActionButtonStyle}"
                                                    Width="86"
                                                    Height="34"
                                                    Margin="0,0,8,0" />

                                            <!-- Color-coded result box (OK/-/X) -->
                                            <Border Grid.Column="2"
                                                    Width="52" Height="34"
                                                    CornerRadius="8"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="1"
                                                    BorderBrush="#44FFFFFF"
                                                    Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{Binding ResultColor}" />
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ResultLabel}"
                                                           FontFamily="Bahnschrift SemiBold"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="3"
                                                       Text="{Binding InfoText}"
                                                       Margin="0,7,0,0"
                                                       FontFamily="Bahnschrift"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border CornerRadius="16"
                                Background="#330F2238"
                                BorderBrush="#55477CFF"
                                BorderThickness="1"
                                Padding="12"
                                Margin="0,2,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding BenchmarkChecklistItem.IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Width="20"
                                              Height="20" />
                                    <Image Source="Assets/Images/Icons/QC/benchmark.png"
                                           Width="24"
                                           Height="24"
                                           Margin="0,0,8,0" />
                                    <TextBlock Text="Benchmark"
                                               FontFamily="Bahnschrift SemiBold"
                                               FontSize="19"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>

                                <ComboBox ItemsSource="{Binding BenchmarkOptions}"
                                          SelectedItem="{Binding SelectedBenchmark, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          FontFamily="Bahnschrift SemiBold"
                                          FontSize="16"
                                          Height="36"
                                          Margin="0,8,0,0"
                                          Foreground="Black"
                                          Background="White"
                                          BorderBrush="#556F9BFF">
                                    <ComboBox.Resources>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="Black" />
                                            <Setter Property="FontFamily" Value="Bahnschrift SemiBold" />
                                            <Setter Property="FontSize" Value="14" />
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Install / Run"
                                            Command="{Binding InstallBenchmarkCommand}"
                                            Style="{StaticResource RoundedActionButtonStyle}"
                                            Width="120"
                                            Height="34" />

                                    <Button Content="Uninstall"
                                            Command="{Binding RemoveBenchmarkCommand}"
                                            Style="{StaticResource RoundedActionButtonStyle}"
                                            Width="100"
                                            Height="34" />

                                    <Button Content="Status"
                                            Command="{Binding ShowQcResultsCommand}"
                                            Style="{StaticResource RoundedActionButtonStyle}"
                                            Width="100"
                                            Height="34"
                                            Margin="8,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding BenchmarkActionStatus}"
                                           Margin="0,8,0,0"
                                           FontFamily="Bahnschrift"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextMutedBrush}" />

                                <Border CornerRadius="14"
                                        Background="#26165C88"
                                        BorderBrush="#55477CFF"
                                        BorderThickness="1"
                                        Padding="12"
                                        Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding RunningTestChecklistItem.IsChecked, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      Width="20"
                                                      Height="20" />
                                            <Image Source="Assets/Images/Icons/QC/battery-test.png"
                                                   Width="24"
                                                   Height="24"
                                                   Margin="0,0,8,0" />
                                            <TextBlock Text="Running Test"
                                                       FontFamily="Bahnschrift SemiBold"
                                                       FontSize="19"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="Run"
                                                Command="{Binding RunningTestChecklistItem.RunCommand}"
                                                Style="{StaticResource RoundedActionButtonStyle}"
                                                Width="82"
                                                Height="34"
                                                Margin="0,0,8,0" />

                                        <Border Grid.Column="2" Style="{StaticResource QcStatusBadgeStyle}">
                                            <TextBlock Text="{Binding RunningTestChecklistItem.StatusText}"
                                                       FontFamily="Bahnschrift SemiBold"
                                                       FontSize="15"
                                                       Foreground="#FFDCEBFF" />
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding RunningTestChecklistItem.InfoText}"
                                                   Margin="0,7,0,0"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
