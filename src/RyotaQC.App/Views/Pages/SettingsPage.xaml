<Page x:Class="RyotaQC.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent">
    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.30">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="18" To="0"
                                     Duration="0:0:0.34">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Command="{Binding BackToHomeCommand}"
                    Style="{StaticResource BackIconButtonStyle}"
                    ToolTip="Kembali ke Main Menu" />

            <TextBlock Grid.Column="1"
                       Text="About"
                       Style="{StaticResource SectionHeaderTextStyle}" />
        </Grid>

        <Border x:Name="SettingsPanel" Grid.Row="1" Style="{StaticResource Ps5GlassCardStyle}" Margin="0,12,0,0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" CornerRadius="12" Background="#3558B4EE" BorderBrush="{DynamicResource BorderBrushNeon}" BorderThickness="1">
                        <Image Source="Assets/Images/Tiles/logo.ico" Stretch="Uniform" Margin="10" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}" FontFamily="Bahnschrift SemiBold" FontSize="28" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,18,0,0" Padding="14" CornerRadius="12" Background="#25000000" BorderBrush="{DynamicResource BorderBrushNeon}" BorderThickness="1">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontFamily="Bahnschrift" FontSize="15" Foreground="{DynamicResource TextMutedBrush}" />
                </Border>

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="Pengaturan" FontFamily="Bahnschrift SemiBold" FontSize="17" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox Margin="0,8,0,0"
                              Content="Jalankan Ryota QC otomatis saat Windows menyala"
                              IsChecked="{Binding LaunchOnStartup}"
                              Foreground="{DynamicResource TextMutedBrush}"
                              FontFamily="Bahnschrift"
                              FontSize="15" />
                    <TextBlock Text="Blueprint" FontFamily="Bahnschrift SemiBold" FontSize="17" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,0" />
                    <TextBlock Text="• C# + WPF + MVVM" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
                    <TextBlock Text="• JSON Tool Configuration" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="• Windows Camera Integration" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="• Dark Blue Glassmorphism UI" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Margin="0,18,0,0"
                           Text="{Binding Copyright}"
                           FontFamily="Bahnschrift"
                           FontSize="13"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>

