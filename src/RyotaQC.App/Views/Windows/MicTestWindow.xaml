<Window x:Class="RyotaQC.App.Views.Windows.MicTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mic Test"
        Width="780"
        Height="470"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="14">
        <Border Style="{StaticResource ShellBorderStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Mic Test (Recording)"
                               Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="Klik Start Recording, bicara ke mikrofon, lalu Stop dan Play untuk cek hasil suara."
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontFamily="Bahnschrift"
                               FontSize="15" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="StartButton"
                            Content="Start Recording"
                            Width="150"
                            Height="40"
                            Style="{StaticResource RoundedActionButtonStyle}"
                            Click="StartRecording_OnClick" />

                    <Button x:Name="StopButton"
                            Grid.Column="1"
                            Content="Stop"
                            Width="110"
                            Height="40"
                            Margin="10,0,0,0"
                            Style="{StaticResource RoundedActionButtonStyle}"
                            Click="StopRecording_OnClick" />

                    <Button x:Name="PlayButton"
                            Grid.Column="2"
                            Content="Play Recording"
                            Width="150"
                            Height="40"
                            Margin="10,0,0,0"
                            Style="{StaticResource RoundedActionButtonStyle}"
                            Click="PlayRecording_OnClick" />

                    <TextBlock x:Name="ElapsedText"
                               Grid.Column="3"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Bahnschrift SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource NeonBlueBrush}"
                               Text="Elapsed: 00:00" />
                </Grid>

                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrushNeon}"
                        BorderThickness="1"
                        Background="{StaticResource Ps5GlassBrush}"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Status"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="18"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,8,0,0"
                                   FontFamily="Bahnschrift"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="Siap untuk test mic." />
                        <TextBlock x:Name="SavedFileText"
                                   Margin="0,10,0,0"
                                   FontFamily="Bahnschrift"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="File rekaman: -" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3"
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Open Folder"
                            Width="120"
                            Height="36"
                            Margin="0,0,8,0"
                            Style="{StaticResource RoundedActionButtonStyle}"
                            Click="OpenFolder_OnClick" />
                    <Button Content="Close"
                            Width="100"
                            Height="36"
                            Style="{StaticResource RoundedActionButtonStyle}"
                            Click="Close_OnClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
