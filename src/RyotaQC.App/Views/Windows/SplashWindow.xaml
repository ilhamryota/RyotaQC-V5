<Window x:Class="RyotaQC.App.Views.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RyotaQC V"
        Width="460"
        Height="240"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True">
    <Border CornerRadius="24"
            BorderThickness="1.6"
            BorderBrush="#885FA8FF"
            Background="#E20E2138"
            Padding="30"
            Effect="{StaticResource Ps5GlowShadow}">
        <StackPanel VerticalAlignment="Center">
            <Image Source="Assets/Images/Tiles/logo.ico"
                   Width="72"
                   Height="72"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="RyotaQC V"
                       FontFamily="Bahnschrift SemiBold"
                       FontSize="40"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0" />
            <TextBlock Text="Quality Control Utility for Windows"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontFamily="Bahnschrift"
                       FontSize="15" />
            <TextBlock Text="Initializing quality control environment..."
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <ProgressBar IsIndeterminate="True" Height="8" Margin="0,26,0,0" />
        </StackPanel>
    </Border>
</Window>
