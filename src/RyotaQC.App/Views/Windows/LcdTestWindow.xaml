<Window x:Class="RyotaQC.App.Views.Windows.LcdTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LCD Test"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        KeyDown="Window_OnKeyDown"
        MouseLeftButtonDown="Window_OnMouseLeftButtonDown">
    <Grid Background="{Binding CurrentBrush}">
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="24"
                CornerRadius="12"
                Background="#64000000"
                Padding="10">
            <TextBlock Foreground="White" FontFamily="Bahnschrift" FontSize="18">
                <Run Text="Space/Click: Next color" />
                <LineBreak />
                <Run Text="ESC: Close" />
            </TextBlock>
        </Border>
    </Grid>
</Window>
