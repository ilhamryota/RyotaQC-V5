<Window x:Class="RyotaQC.App.Views.Windows.QcResultsPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hasil QC"
        Width="560"
        Height="680"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1425"
        AllowsTransparency="True"
        ShowInTaskbar="False">
    <Border CornerRadius="16" Background="#E60F1425" BorderBrush="#556FA7FF" BorderThickness="1.5" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                <Border Width="36" Height="36" CornerRadius="10" Background="#33263A5E" BorderBrush="#554CA7FF" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#4CA7FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Hasil QC"
                           Foreground="#F6F8FF"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Summary count -->
            <TextBlock Grid.Row="1"
                       x:Name="SummaryText"
                       Text=""
                       Foreground="#AEB7CA"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Margin="0,4,0,10" />

            <!-- Checklist results -->
            <Border Grid.Row="2" CornerRadius="10" Background="#22000000" BorderBrush="#33477CFF" BorderThickness="1" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ResultsList" Margin="4" />
                </ScrollViewer>
            </Border>

            <!-- Save buttons + Close -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <!-- Save PDF -->
                    <Button Width="150" Height="42" Margin="0,0,10,0" Click="SavePdf_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="PdfBorder" CornerRadius="12" Background="#FF1E7A4B" BorderBrush="#5539C86B" BorderThickness="1.5">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Save PDF" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="PdfBorder" Property="Background" Value="#FF248A57" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Save Notepad -->
                    <Button Width="160" Height="42" Margin="0,0,10,0" Click="SaveNotepad_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="NotepadBorder" CornerRadius="12" Background="#FF1E435A" BorderBrush="#556FA7FF" BorderThickness="1.5">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Save Notepad" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="NotepadBorder" Property="Background" Value="#FF22506F" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close -->
                    <Button Width="110" Height="42" Click="Close_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBorder" CornerRadius="12" Background="#44444444" BorderBrush="#66FFFFFF" BorderThickness="1.5">
                                    <TextBlock Text="Tutup"
                                               FontFamily="Segoe UI"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBorder" Property="Background" Value="#55555555" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
