<Window x:Class="RyotaQC.App.Views.Windows.QcTimeInputPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hasil Test"
        Width="420"
        Height="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1425"
        AllowsTransparency="True"
        ShowInTaskbar="False">
    <Border CornerRadius="16" Background="#E60F1425" BorderBrush="#556FA7FF" BorderThickness="1.5" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="#33263A5E" BorderBrush="#554CA7FF" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="&#xE917;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#4CA7FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Text="Berapa lama hasil test?"
                           Foreground="#F6F8FF"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Question -->
            <TextBlock Grid.Row="1"
                       x:Name="QuestionText"
                       Text="Masukkan durasi hasil test:"
                       Foreground="#AEB7CA"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       Margin="0,16,0,0" />

            <!-- Time input boxes -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Jam" Foreground="#AEB7CA" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center" />
                    <TextBox x:Name="HoursBox"
                             Width="80" Height="44"
                             FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                             Foreground="#F6F8FF" Background="#22182C44"
                             BorderBrush="#556FA7FF" BorderThickness="1.5"
                             Padding="8,4" Margin="0,4,0,0"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             CaretBrush="#4CA7FF"
                             PreviewTextInput="NumberOnly_PreviewTextInput"
                             MaxLength="3" />
                </StackPanel>
                <TextBlock Text=":" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold" Foreground="#AEB7CA" VerticalAlignment="Center" Margin="12,20,12,0" />
                <StackPanel>
                    <TextBlock Text="Menit" Foreground="#AEB7CA" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Center" />
                    <TextBox x:Name="MinutesBox"
                             Width="80" Height="44"
                             FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                             Foreground="#F6F8FF" Background="#22182C44"
                             BorderBrush="#556FA7FF" BorderThickness="1.5"
                             Padding="8,4" Margin="0,4,0,0"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             CaretBrush="#4CA7FF"
                             PreviewTextInput="NumberOnly_PreviewTextInput"
                             MaxLength="2" />
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Width="100" Height="40" Content="Batal" Margin="0,0,12,0" Click="Cancel_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CancelB" CornerRadius="10" Background="#44444444" BorderBrush="#66FFFFFF" BorderThickness="1.2">
                                <TextBlock Text="Batal" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CancelB" Property="Background" Value="#55555555" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Width="100" Height="40" Content="Submit" Click="Submit_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SubmitB" CornerRadius="10" Background="#FF1E7A4B" BorderBrush="#5539C86B" BorderThickness="1.2">
                                <TextBlock Text="Submit" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SubmitB" Property="Background" Value="#FF248A57" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
