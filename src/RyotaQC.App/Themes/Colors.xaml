<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- PS5-inspired palette -->
    <Color x:Key="AppBackgroundColor">#FF071426</Color>
    <Color x:Key="SurfaceColor">#D6112748</Color>
    <Color x:Key="SurfaceAltColor">#BC15355C</Color>
    <Color x:Key="NeonBlueColor">#FF2E7CFF</Color>
    <Color x:Key="NeonBlueSoftColor">#AA2E7CFF</Color>
    <Color x:Key="BorderColor">#663F77FF</Color>
    <Color x:Key="TextPrimaryColor">#FFF5FAFF</Color>
    <Color x:Key="TextMutedColor">#FFD5E4F5</Color>

    <!-- PS5 extended tones -->
    <Color x:Key="Ps5AccentColor">#FF2E7CFF</Color>
    <Color x:Key="Ps5AccentBrightColor">#FF5FA8FF</Color>
    <Color x:Key="Ps5WaveColor">#FF1E4FD8</Color>
    <Color x:Key="Ps5WaveDeepColor">#FF0C1E52</Color>
    <Color x:Key="Ps5GlassColor">#33122B4A</Color>
    <Color x:Key="Ps5CardBorderColor">#885F87FF</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="NeonBlueBrush" Color="{StaticResource NeonBlueColor}" />
    <SolidColorBrush x:Key="NeonBlueSoftBrush" Color="{StaticResource NeonBlueSoftColor}" />
    <SolidColorBrush x:Key="BorderBrushNeon" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="Ps5AccentBrush" Color="{StaticResource Ps5AccentColor}" />
    <SolidColorBrush x:Key="Ps5AccentBrightBrush" Color="{StaticResource Ps5AccentBrightColor}" />
    <SolidColorBrush x:Key="Ps5WaveBrush" Color="{StaticResource Ps5WaveColor}" />
    <SolidColorBrush x:Key="Ps5WaveDeepBrush" Color="{StaticResource Ps5WaveDeepColor}" />
    <SolidColorBrush x:Key="Ps5GlassBrush" Color="{StaticResource Ps5GlassColor}" />
    <SolidColorBrush x:Key="Ps5CardBorderBrush" Color="{StaticResource Ps5CardBorderColor}" />

    <LinearGradientBrush x:Key="Ps5WaveFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#662E7CFF" Offset="0" />
        <GradientStop Color="#221E4FD8" Offset="0.55" />
        <GradientStop Color="#000C1E52" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Ps5WaveFillBrushAlt" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#445FA8FF" Offset="0" />
        <GradientStop Color="#221E4FD8" Offset="0.5" />
        <GradientStop Color="#00071426" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Ps5AmbientGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E2E7CFF" Offset="0" />
        <GradientStop Color="#001E4FD8" Offset="0.65" />
    </LinearGradientBrush>
</ResourceDictionary>
